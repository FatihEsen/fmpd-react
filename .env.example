# --- MPD bağlantısı ---
# FMPD'nin doğrudan bağlanacağı Music Player Daemon sunucusu.
# Yerel makinede çalışan MPD için:
MPD_HOST="localhost"
MPD_PORT="6600"
# MPD'de password tanımlıysa buraya yazın (mpd.conf -> password)
MPD_PASSWORD=""

# --- Web sunucusu ---
# FMPD'nin dinleyeceği port (varsayılan: 3000)
PORT="3000"

# NODE_ENV=development -> production build yerine Vite middleware kullanılır.
# NODE_ENV=production  -> ./dist içeriği servis edilir (build yoksa otomatik dev'e düşer)
# NODE_ENV=
